# ─── Required ─────────────────────────────────────────────
# OpenAI API key (used for comment and post generation)
OPENAI_API_KEY=sk-your-key-here

# ─── LinkedIn Credentials (Option A: use profile manager) ─
# Run: python linkedin_profile_manager.py add
# This stores credentials encrypted in data/profiles/profiles.json
# You can add multiple profiles for different LinkedIn accounts

# ─── LinkedIn Credentials (Option B: .env auto-migrate) ────
# If you set these, they auto-migrate to a "default" profile on first run
# LINKEDIN_USERNAME=your-email@example.com
# LINKEDIN_PASSWORD=your-password

# ─── For a second LinkedIn account (optional) ─────────────
# LINKEDIN_ALT_USERNAME=alt-email@example.com
# LINKEDIN_ALT_PASSWORD=alt-password
